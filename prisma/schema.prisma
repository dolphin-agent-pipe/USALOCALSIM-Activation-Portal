generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// NextAuth models (compatible with Prisma adapter)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed; for Credentials provider
  role          String    @default("dealer") // "admin" | "dealer"
  dealerId      String?   // optional external dealer id for tracking
  disabled      Boolean   @default(false) // when true, login is blocked and sessions invalidated on refresh
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  vouchersActivated Voucher[] @relation("ActivatedBy")
  passwordChangeOtp PasswordChangeOtp?
  partnerLinks      PartnerUser[]
}

model PasswordChangeOtp {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// App models
model Network {
  id           String   @id @default(cuid())
  slug         String   @unique // three_uk | linkup_att | t_mobile | orange
  name         String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  plans        Plan[]
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  /// Client catalog SKU (e.g. TM-UNL-30D). Unique per planType (physical_sim / esim).
  sku           String?
  dataAllowance String   // e.g. "Unlimited", "5GB"
  durationDays  Int
  priceCents    Int
  planType      String   // "physical_sim" | "esim"
  market        String   // "global" | "us" | "br" | "uk"
  /// Card tier: basic | pro | ultra (feedback card design).
  coverageTier  String?
  networkId     String?
  network       Network? @relation(fields: [networkId], references: [id], onDelete: SetNull)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  vouchers      Voucher[]
  activationRequests ActivationRequest[]
  cartPurchases CartPurchase[]
  prepaidCardsBase    PrepaidCard[] @relation("PrepaidCardBasePlan")
  prepaidCardsUpgrade PrepaidCard[] @relation("PrepaidCardUpgradePlan")

  @@unique([sku, planType])
  @@index([networkId])
  @@index([coverageTier])
  @@index([sku])
}

model Voucher {
  id                 String   @id @default(cuid())
  code               String   @unique
  pinCodeHash        String?
  pinLast4           String?  @db.VarChar(8)
  creditAmountCents  Int      @default(0)
  /// USD cents the customer entered at prepaid cart checkout (must match Stripe charged amount).
  declaredPayCents Int?
  customerName       String?
  customerEmail      String?
  customerPhone      String?
  /// Brazilian CPF digits only (11), collected at Phase 2 registration (feedback 2026-07-17).
  customerCpf        String?
  /// Set true after Phase 2 redeemer SMS OTP (service line). Phase 1 payment does not use SMS.
  isVerified         Boolean  @default(false)
  paymentStatus      Boolean  @default(false)
  linkedIccid        String?
  fulfillmentType    String?  // "EXISTING_SIM" | "NEW_SIM_SHIPPING" | "ESIM"
  status             String   // "inactive" | "eligible" | "activated" | "redeemed"
  type               String   // "top_up" | "esim"
  /// global = all networks at redeem; three_uk = Three UK plans only (feedback 2026-05-28).
  voucherProductType String   @default("global")
  planId             String
  plan               Plan     @relation(fields: [planId], references: [id])
  activatedAt        DateTime?
  activatedById      String?
  activatedBy        User?    @relation("ActivatedBy", fields: [activatedById], references: [id])
  redeemedAt         DateTime?
  redeemedBy         String?  // email or ICCID
  createdAt          DateTime @default(now())
  activationRequest  ActivationRequest?
  cartPurchase CartPurchase?
  prepaidCard  PrepaidCard?

  /// Partner inventory ownership (independent of operational status).
  /// UNASSIGNED | ASSIGNED | SOLD | REDEEMED | CANCELLED
  inventoryStatus   String    @default("UNASSIGNED")
  partnerId         String?
  partner           Partner?  @relation("VoucherAssignedPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  storeId           String?
  store             PartnerStore? @relation("VoucherAssignedStore", fields: [storeId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?
  saleTransactionId String?
  soldAt            DateTime?
  assignments       VoucherAssignment[]
  commission        Commission?

  @@index([pinLast4])
  @@index([inventoryStatus])
  @@index([partnerId])
  @@index([storeId])
}

// Physical prepaid card: QR serial + optional barcode → scratch PIN (Voucher) → wallet credit.
model PrepaidCard {
  id                   String       @id @default(cuid())
  serial               String       @unique
  /// GS1 / POS scan value (may equal serial). Unique when set.
  barcodePayload       String?      @unique
  gtin                 String?
  /// Shelf market: us | br | uk (aligns with Plan.market where possible).
  retailMarket         String       @default("us")
  /// Denomination loaded into voucher wallet when sold (POS or D2C).
  faceValueCents       Int          @default(0)
  voucherId            String       @unique
  voucher              Voucher      @relation(fields: [voucherId], references: [id])
  basePlanId           String
  basePlan             Plan         @relation("PrepaidCardBasePlan", fields: [basePlanId], references: [id])
  upgradePlanId        String?
  upgradePlan          Plan?        @relation("PrepaidCardUpgradePlan", fields: [upgradePlanId], references: [id])
  claimedCartSessionId String?      @unique
  claimedCartSession   CartSession? @relation(fields: [claimedCartSessionId], references: [id])
  createdAt            DateTime     @default(now())
  cartPurchase         CartPurchase?
  partnerId            String?
  partner              Partner?     @relation("PrepaidCardAssignedPartner", fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([retailMarket])
  @@index([partnerId])
}

// Cart session for physical-card checkout. phoneE164/verifiedAt set only for legacy SMS Phase-1 paths.
model CartSession {
  id                   String         @id @default(cuid())
  phoneE164            String?
  verifiedAt           DateTime?
  expiresAt            DateTime
  createdAt            DateTime       @default(now())
  /// Phase 1 LINKUP checkout handoff (feedback 2026-07-06).
  checkoutCustomerName String?
  checkoutEmail        String?
  checkoutPreparedAt   DateTime?
  purchases            CartPurchase[]
  claimedPrepaidCard   PrepaidCard?

  @@index([phoneE164])
  @@map("ShopSession")
}

// Opaque token emailed after cart payment so the customer can resume redeem if the browser session is lost.
model CartPurchaseResumeToken {
  id             String       @id @default(cuid())
  token          String       @unique @db.VarChar(64)
  cartPurchaseId String       @unique
  cartPurchase   CartPurchase @relation(fields: [cartPurchaseId], references: [id], onDelete: Cascade)
  phoneE164      String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@map("CartPurchaseResumeToken")
}

model CartPhoneOtp {
  id          String   @id @default(cuid())
  phoneE164 String   @unique
  attempts    Int      @default(0)
  lastSentAt  DateTime @default(now())

  @@map("ShopPhoneOtp")
}

// Paid plan authorization before physical PIN redemption.
model CartPurchase {
  id               String      @id @default(cuid())
  cartSessionId    String      @map("shopSessionId")
  cartSession      CartSession @relation(fields: [cartSessionId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan        @relation(fields: [planId], references: [id])
  stripePaymentId  String      @unique
  /// stripe | mercadopago | pos — how Phase 1 wallet was funded.
  paymentSource    String      @default("stripe")
  /// Idempotency key (POS txn id, MP payment id). Unique when set.
  externalPaymentRef String?   @unique
  amountPaidCents  Int
  customerName     String?
  customerEmail    String
  /// Brazilian CPF digits only (11), collected at Phase 2 registration (feedback 2026-07-17).
  customerCpf      String?
  status             String // "authorized" | "redeemed"
  voucherId        String?     @unique
  voucher          Voucher?    @relation(fields: [voucherId], references: [id])
  serviceStartDate DateTime?
  redeemedAt       DateTime?
  createdAt        DateTime    @default(now())
  resumeToken      CartPurchaseResumeToken?
  prepaidCardId    String?     @unique
  prepaidCard      PrepaidCard?  @relation(fields: [prepaidCardId], references: [id])
  // Opaque token: redeem/schedule UI without SMS (link from payment email).
  redemptionAccessToken       String?   @unique @db.VarChar(64)
  redemptionAccessExpiresAt   DateTime?
  redemptionFulfillmentType String? // "EXISTING_SIM" | "NEW_SIM_SHIPPING" | "ESIM"
  redemptionIccid           String?
  redemptionDeviceImei      String?
  redemptionDeviceEid       String?
  redemptionShippingAddress String? @db.Text
  redemptionShippingCents   Int     @default(0)
  redemptionCreditAppliedCents Int  @default(0)
  redemptionExtraPaidCents  Int     @default(0)
  redemptionFinalTotalCents Int     @default(0)
  /// Phase 2 redeemer line (feedback-2026-05-01); independent of Phase 1 cart session phone.
  redemptionPhoneE164        String?
  redemptionPhoneVerifiedAt DateTime?
  /// Carrier chosen after SMS (global voucher) or auto-set for Three UK batch.
  redemptionNetworkSlug     String?
  /// basic | pro | ultra — card coverage tier (global voucher).
  redemptionCoverageTier  String?
  /// JSON array of T-Mobile add-on SKUs (ADD-TM-*), when network is t_mobile.
  redemptionAddonSkus     String?  @db.Text
  commission              Commission?

  @@index([cartSessionId])
  @@index([redemptionNetworkSlug])
  @@index([redemptionCoverageTier])
  @@map("ShopPurchase")
}

model ActivationRequest {
  id               String   @id @default(cuid())
  iccid            String?
  voucherCode      String?
  email            String
  /// E.164 service phone when known (cart voucher / Phase 2 redeemer; voucher submit uses voucher row).
  customerPhoneE164 String?
  scenario         String   // "sim_only" | "combo" | "esim_voucher" | "cart_voucher" (legacy rows may differ)
  planId           String
  plan             Plan     @relation(fields: [planId], references: [id])
  amountPaidCents  Int      @default(0)
  travelDate       DateTime?
  hasPartnerSim    Boolean  @default(false)
  hardwareDeductionCents Int @default(0)
  shippingDeductionCents Int @default(0)
  stripePaymentId  String?
  status           String   // "scheduled" | "active"
  completedAt      DateTime?
  completedById    String?
  createdAt        DateTime @default(now())
  voucherId        String?  @unique
  voucher          Voucher? @relation(fields: [voucherId], references: [id])
  esimQrPayload    String?  @db.Text // LPA/SMDP+ string or QR payload for eSIM delivery email
  deviceImei                 String?
  deviceEid                  String?
  physicalSimNumber          String?
  deviceDetailsImageDataUrl  String?  @db.LongText
  simCardImageDataUrl        String?  @db.LongText

  @@index([iccid])
}

model SimHardwareCostByMarket {
  market    String   @id // "global" | "us" | "uk" | "br"
  cents     Int
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  metadata  String?  @db.Text // JSON: ip, userAgent, resourceId
  createdAt DateTime @default(now())
}

model RateLimitBlock {
  id           String   @id @default(cuid())
  key          String   // e.g. ip:123.45.67.89
  blockedUntil DateTime
  createdAt    DateTime @default(now())
  @@index([key, blockedUntil])
}

// Single-row config: strict ON = ICCID must exist in IccidWhitelist; OFF = Luhn pattern fallback only.
model IccidValidationConfig {
  id                  String   @id // fixed "default"
  strictDatabaseCheck Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

// Master ICCID list (normalized digits). Used when strictDatabaseCheck is true.
model IccidWhitelist {
  iccid     String   @id @db.VarChar(32)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Partner commission Phase A — partners, payout profile, voucher assignment
// (Commission ledger + Wise payouts land in later phases.)
// ---------------------------------------------------------------------------

model Partner {
  id                     String   @id @default(cuid())
  name                   String
  countryCode            String   @default("BR") @db.VarChar(2)
  email                  String?
  phoneE164              String?
  /// Default commission in BRL centavos (6000 = R$60). Admin-editable; future sales only.
  defaultCommissionCents Int      @default(6000)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  payoutProfile PartnerPayoutProfile?
  stores        PartnerStore[]
  users         PartnerUser[]
  assignments   VoucherAssignment[]
  vouchers      Voucher[]     @relation("VoucherAssignedPartner")
  prepaidCards  PrepaidCard[] @relation("PrepaidCardAssignedPartner")
  commissions   Commission[]
  chargebackBalances PartnerChargebackBalance[]
  payoutBatches PayoutBatch[]

  @@index([active])
}

model PartnerStore {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  vouchers Voucher[] @relation("VoucherAssignedStore")

  @@index([partnerId])
}

model PartnerUser {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String  @default("dealer") // dealer | manager

  @@unique([partnerId, userId])
  @@index([userId])
}

/// Brazilian bank recipient for Wise partner payouts (not PIX).
model PartnerPayoutProfile {
  id                  String    @id @default(cuid())
  partnerId           String    @unique
  partner             Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  payoutMethod        String    @default("wise_br_bank")
  currency            String    @default("BRL") @db.VarChar(3)
  legalType           String // PRIVATE | BUSINESS
  accountHolderName   String
  taxId               String // CPF/CNPJ digits only
  taxIdType           String // CPF | CNPJ
  bankCode            String?
  branchCode          String?
  accountNumber       String?
  accountType         String?
  addressLine1        String?
  addressCity         String?
  addressState        String?
  addressPostCode     String?
  addressCountry      String?   @default("BR") @db.VarChar(2)
  wiseRecipientId     String?   @unique
  wiseRecipientStatus String?
  wiseRecipientRaw    String?   @db.Text
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([payoutMethod])
}

/// Immutable history of partner assignment (never delete).
model VoucherAssignment {
  id           String   @id @default(cuid())
  voucherId    String
  voucher      Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  partnerId    String?
  partner      Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  storeId      String?
  /// assigned | unassigned | reassigned
  action       String
  batchLabel   String?
  serialFrom   String?
  serialTo     String?
  assignedById String?
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([voucherId, createdAt])
  @@index([partnerId])
}

// ---------------------------------------------------------------------------
// Partner commission Phase B — ledger (Wise payouts in Phase D)
// ---------------------------------------------------------------------------

model Commission {
  id                    String   @id @default(cuid())
  partnerId             String
  partner               Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  /// PENDING_FUNDS | ELIGIBLE | INCLUDED_IN_PAYOUT | PAID | CANCELLED |
  /// CHARGEBACK_ADJUSTMENT | OFFSET_PARTIAL | OFFSET_SETTLED | ADMIN_REVIEW
  status                String   @default("PENDING_FUNDS")

  /// Snapshotted BRL centavos owed for this voucher sale.
  amountBrlCents        Int
  currency              String   @default("BRL") @db.VarChar(3)

  voucherId             String   @unique
  voucher               Voucher  @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  voucherSerialSnapshot String?
  cartPurchaseId        String?  @unique
  cartPurchase          CartPurchase? @relation(fields: [cartPurchaseId], references: [id], onDelete: SetNull)

  saleTransactionId     String   @unique
  paymentProvider       String
  saleAmountCents       Int?
  saleCurrency          String?  @db.VarChar(3)
  customerCountry       String?  @db.VarChar(2)

  soldAt                DateTime
  fundsAvailableAt      DateTime?
  eligibleAt            DateTime?

  /// BRL centavos applied from this commission toward open chargeback balances.
  offsetAppliedBrlCents Int      @default(0)

  payoutBatchId         String?
  payoutBatch           PayoutBatch?  @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  payoutAttemptId       String?
  payoutAttempt         PayoutAttempt? @relation(fields: [payoutAttemptId], references: [id], onDelete: SetNull)

  chargebackOfCommissionId String?
  refundExternalRef     String?
  failureReason         String?  @db.Text

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  statusHistory         CommissionStatusEvent[]
  sourceChargebackBalance PartnerChargebackBalance?
  offsetAllocationsAsOld CommissionOffsetAllocation[] @relation("OffsetOld")
  offsetAllocationsAsNew CommissionOffsetAllocation[] @relation("OffsetNew")

  @@index([partnerId, status])
  @@index([status, soldAt])
  @@index([payoutBatchId])
}

model CommissionStatusEvent {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  fromStatus   String?
  toStatus     String
  note         String?
  createdAt    DateTime   @default(now())

  @@index([commissionId, createdAt])
}

/// Outstanding negative balance after a paid commission was refunded/charged back.
model PartnerChargebackBalance {
  id                    String   @id @default(cuid())
  partnerId             String
  partner               Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  sourceCommissionId    String   @unique
  sourceCommission      Commission @relation(fields: [sourceCommissionId], references: [id], onDelete: Restrict)
  voucherSerialSnapshot String?
  /// Remaining BRL centavos to recover (positive = debt).
  remainingBrlCents     Int
  originalBrlCents      Int
  /// OPEN | SETTLED | ADMIN_REVIEW
  status                String   @default("OPEN")
  /// customer_refund | partner_irregularity
  reason                String   @default("customer_refund")
  refundExternalRef     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  allocations           CommissionOffsetAllocation[]

  @@index([partnerId, status])
}

/// Explicit old-voucher <-> new-voucher offset audit lines.
model CommissionOffsetAllocation {
  id                  String   @id @default(cuid())
  chargebackBalanceId String
  chargebackBalance   PartnerChargebackBalance @relation(fields: [chargebackBalanceId], references: [id], onDelete: Cascade)
  oldCommissionId     String
  oldCommission       Commission @relation("OffsetOld", fields: [oldCommissionId], references: [id])
  newCommissionId     String
  newCommission       Commission @relation("OffsetNew", fields: [newCommissionId], references: [id])
  amountBrlCents      Int
  createdAt           DateTime @default(now())

  @@index([oldCommissionId])
  @@index([newCommissionId])
  @@index([chargebackBalanceId])
}

// ---------------------------------------------------------------------------
// Partner commission Phase D — daily Wise consolidated payouts
// ---------------------------------------------------------------------------

model PayoutBatch {
  id            String   @id @default(cuid())
  partnerId     String
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  /// CREATED | SUBMITTED | PROCESSING | PAID | FAILED | REVIEW
  status        String   @default("CREATED")
  /// Sum of net BRL actually sent (after offsets applied to included commissions).
  totalBrlCents Int      @default(0)
  currency      String   @default("BRL") @db.VarChar(3)
  /// Calendar date of daily run (UTC).
  payoutDate    DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  commissions   Commission[]
  attempts      PayoutAttempt[]

  @@unique([partnerId, payoutDate])
  @@index([status, payoutDate])
}

model PayoutAttempt {
  id                 String      @id @default(cuid())
  batchId            String
  batch              PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  partnerId          String
  wiseRecipientId    String?
  /// CREATED | QUOTED | SUBMITTED | PROCESSING | PAID | FAILED
  status             String      @default("CREATED")
  amountBrlCents     Int
  currency           String      @default("BRL") @db.VarChar(3)
  wiseQuoteId        String?
  wiseTransferId     String?     @unique
  wiseFeeSourceCents Int?
  wiseRate           String?
  wiseTransferNature String?
  wiseRawQuote       String?     @db.Text
  wiseRawTransfer    String?     @db.Text
  wiseStatusMessage  String?     @db.Text
  requestedAt        DateTime    @default(now())
  completedAt        DateTime?
  failedAt           DateTime?
  commissions        Commission[]

  @@index([partnerId, status])
  @@index([batchId])
}
