# Database (Hostinger MySQL from hPanel)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# Stripe
STRIPE_SECRET_KEY="sk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."

# Email (Option A: Resend - set RESEND_API_KEY; Option B: SMTP - set SMTP_*)
# Cart Stripe webhook sends a payment receipt + resume link when RESEND or SMTP is configured.
# RESEND_API_KEY="re_..."
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT=465
# SMTP_USER="..."
# SMTP_PASS="..."
EMAIL_FROM="noreply@yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SIM_HARDWARE_COST_CENTS=999
# Printable invoice (/invoice/[purchaseId]) — distributor name on receipt; support line in footer
# INVOICE_DISTRIBUTOR_NAME="USALOCALSIM"
# INVOICE_SUPPORT_EMAIL="support@yourdomain.com"

# Redeem wizard — default is card-design tier flow (SMS → BASIC/PRO/ULTRA → networks → plans).
# Set false for legacy briefing flow (SMS → four network logos → plans).
# REDEEM_USE_TIER_STEP="false"
# Hide plans priced below voucher credit (default on). Set false to show all plans.
# REDEEM_HIDE_UNDERPRICED_PLANS="true"
# Card mentions Bitcoin; portal uses Stripe/Mercado Pago — optional customer-facing note on /redeem/enter
# NEXT_PUBLIC_PAYMENT_METHODS_NOTE="Upgrades are paid by card (Apple Pay / Google Pay when enabled). Bitcoin on the card is marketing only."
# Scratch PIN prefixes (printed under scratch panel; first value used for admin card generation)
# VOUCHER_PREFIX_GLOBAL="USL-G-"
# VOUCHER_PREFIX_THREE_UK="USLTUK-,3UK-,USL-3UK-"

# /cart — optional ISO country code for national phone input without + (e.g. GB, DE). International +… always works.
# SHOP_PHONE_DEFAULT_REGION="US"

# /cart voucher flow — Prelude SMS verification (https://docs.prelude.so/verify/v2/documentation/quickstart)
# PRELUDE_API_TOKEN="..."   # or API_TOKEN — v2 API key from Prelude dashboard
# Optional: PRELUDE_DEBUG=1 — return more detailed Prelude errors in API responses (dev/troubleshooting)
# Optional: SHOP_PRELUDE_SKIP=1 — do not call Prelude; use code 123456 at verify step (local dev only)
# SHOP_PRELUDE_SKIP=1

# Path B — POS activation (retailer scan + pay)
# POS_API_KEY="long-random-secret"

# Partner commission + Wise payouts (Phases B–F)
# COMMISSION_PAYOUTS_ENABLED="true"
# COMMISSION_PAYOUTS_SIMULATE="true"   # dev only — marks PAID without Wise API
# COMMISSION_PAYOUT_CRON_SECRET="long-random-secret"
# COMMISSION_CRON_LOCK_TTL_SECONDS=3600
# COMMISSION_ALERT_EMAIL="ops@yourdomain.com,finance@yourdomain.com"
# COMMISSION_PAYOUT_STUCK_HOURS=48
# COMMISSION_IMMEDIATE_FUNDS_AVAILABLE="false"
# COMMISSION_STRIPE_SETTLEMENT_DAYS=2
# COMMISSION_MP_SETTLEMENT_DAYS=1
# WISE_API_BASE_URL="https://api.sandbox.transferwise.tech"
# WISE_API_TOKEN="..."
# WISE_PROFILE_ID="12345678"
# WISE_SOURCE_CURRENCY="USD"
# WISE_TRANSFER_NATURE="SERVICES"
# WISE_WEBHOOK_SECRET="..."

# Customer PIX checkout (Phase E) — switch provider without commission changes
# PIX_PROVIDER="none" | "stripe" | "asaas"
# NEXT_PUBLIC_PIX_PROVIDER="asaas"
# COMMISSION_PIX_IMMEDIATE_SETTLE="true"
# ASAAS_API_KEY="..."
# ASAAS_API_BASE_URL="https://api-sandbox.asaas.com"
# ASAAS_ENV="sandbox"
# ASAAS_WEBHOOK_TOKEN="..."

# /cart + Phase 2 upgrade (Brazil) — Mercado Pago Checkout Pro (legacy Asaas bridge when PIX_PROVIDER=asaas)
# MERCADOPAGO_ACCESS_TOKEN="..."
# NEXT_PUBLIC_CART_MERCADOPAGO_ENABLED="true"
